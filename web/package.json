{
  "name": "multiharness-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:content": "node --test tests/docker-content.test.mjs tests/docker-commands.test.mjs tests/docker-powershell.test.mjs",
    "format": "prettier --write src tests index.html *.js *.json",
    "prebuild": "python3 ../scripts/package-docker.py --output public/downloads/multiharness-docker.zip",
    "predev": "python3 ../scripts/package-docker.py --output public/downloads/multiharness-docker.zip"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
