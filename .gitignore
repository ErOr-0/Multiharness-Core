# Binaries for Go programs
# (Ignores compiled executables like your api or migrate binaries)
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
.coverage/

# Dependency directory (if using vendor, though usually go modules handle this)
vendor/

# Environment and local configuration files
.env
.env.local

# Operating System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
