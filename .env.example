# Copy this file to .env beside compose.yaml and set your existing absolute folder.
# Windows example: 'D:/Projects'. macOS example: '/Users/yourname/Projects'.
MULTIHARNESS_WORKSPACE='/absolute/path/to/your/projects'
# Native Linux: set these to the output of id -u and id -g. Docker Desktop: keep 1000.
MULTIHARNESS_UID=1000
MULTIHARNESS_GID=1000
