{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2"
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "critical"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "blocking",
          "file",
          "line",
          "description",
          "evidence",
          "required_action"
        ]
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_action": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "executable": {
              "minLength": 1,
              "type": "string"
            },
            "args": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object",
          "required": [
            "executable",
            "args",
            "reason"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "approved",
    "summary",
    "findings",
    "suggestions",
    "validation_action"
  ]
}
